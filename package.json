{
  "name": "riverbend-clinical-env",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "prepare": "git config core.hooksPath scripts/hooks",
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json",
    "test": "vitest run",
    "cli": "node cli/index.ts",
    "donewhen": "node scripts/donewhen.ts",
    "keyscan": "node scripts/keyscan.ts",
    "ci:guard": "node scripts/ci-guard.ts",
    "fixtures:build": "echo 'fixtures:build is not built yet (P5)' >&2 && exit 1",
    "fixtures:verify": "echo 'fixtures:verify is not built yet (P5)' >&2 && exit 1",
    "fixtures:lint": "echo 'fixtures:lint is not built yet (P4)' >&2 && exit 1",
    "live:node": "node scripts/live-node.ts",
    "docs:check": "echo 'docs:check is not built yet (writeup PR)' >&2 && exit 1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
