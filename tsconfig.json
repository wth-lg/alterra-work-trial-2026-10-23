{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": [
    "cli",
    "scripts",
    "packages",
    "tasks",
    "vitest.config.ts",
    "apps/runner",
    "apps/web/build",
    "apps/web/test",
    "eslint-rules/rules.test.ts",
    "eslint-rules/test"
  ],
  // Listed by name: exclude does not apply to files, and scripts/fixtures stays excluded.
  "files": ["scripts/fixtures/donewhen/stub-cli.ts"],
  // cli/zz-nested-config-* is the directory scripts/test/ci-guard.test.ts plants and deletes;
  // keeping it out of the program stops a concurrent tsc run from failing on a deleted file.
  "exclude": ["node_modules", "**/node_modules", "scripts/fixtures", "cli/zz-nested-config-*"]
}
