{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": [
    "cli",
    "scripts",
    "packages",
    "tasks",
    "vitest.config.ts",
    "apps/web/build",
    "apps/web/test",
    "eslint-rules/rules.test.ts"
  ],
  // Listed by name: exclude does not apply to files, and scripts/fixtures stays excluded.
  "files": ["scripts/fixtures/donewhen/stub-cli.ts"],
  "exclude": ["node_modules", "**/node_modules", "scripts/fixtures"]
}
